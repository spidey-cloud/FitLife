<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only. Cleartext is already blocked by default on API 28+, but FitLife supports API 26-27,
  where it is allowed by default. User-installed CAs are not trusted (system CAs only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
